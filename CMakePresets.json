{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    { "name": "base", "hidden": true, "binaryDir": "${sourceDir}/build/${presetName}" },
    { "name": "msvc", "inherits": "base", "generator": "Visual Studio 18 2026" },
    { "name": "linux-base", "hidden": true, "inherits": "base", "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "linux-gcc", "inherits": "linux-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" } },
    { "name": "linux-clang", "inherits": "linux-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" } }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "linux-gcc", "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "configurePreset": "linux-clang" }
  ],
  "testPresets": [
    { "name": "test-base", "hidden": true, "output": { "outputOnFailure": true }, "execution": { "timeout": 60 } },
    { "name": "msvc-debug", "inherits": "test-base", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "linux-gcc", "inherits": "test-base", "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "inherits": "test-base", "configurePreset": "linux-clang" }
  ],
  "workflowPresets": [
    { "name": "msvc", "steps": [
      { "type": "configure", "name": "msvc" }, { "type": "build", "name": "msvc-debug" }, { "type": "test", "name": "msvc-debug" } ] },
    { "name": "linux-gcc", "steps": [
      { "type": "configure", "name": "linux-gcc" }, { "type": "build", "name": "linux-gcc" }, { "type": "test", "name": "linux-gcc" } ] },
    { "name": "linux-clang", "steps": [
      { "type": "configure", "name": "linux-clang" }, { "type": "build", "name": "linux-clang" }, { "type": "test", "name": "linux-clang" } ] }
  ]
}
